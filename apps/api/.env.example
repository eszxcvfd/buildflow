# Copy to `apps/api/.env` and adjust for the selected local services.
# Never commit the real `.env` file.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
# Required comma-separated browser allowlist. Add the deployed Web origin in
# production; add a LAN Web origin only when another device must open the Web app.
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
# May target PostgreSQL 18.x installed locally or the optional Docker service.
DATABASE_URL=postgresql://buildflow:buildflow@localhost:5432/buildflow
# Optional: leave blank to skip a dependency check.
MINIO_ENDPOINT=
MINIO_PORT=9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
