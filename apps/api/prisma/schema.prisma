/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model assignments {
  id                                           String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  work_order_id                                String                     @db.Uuid
  assignee_type                                String                     @db.VarChar(10)
  worker_id                                    String?                    @db.Uuid
  crew_id                                      String?                    @db.Uuid
  responsible_user_id                          String                     @db.Uuid
  source                                       String                     @db.VarChar(25)
  status                                       String                     @default("ACTIVE") @db.VarChar(25)
  requires_acceptance                          Boolean                    @default(false)
  assigned_by                                  String?                    @db.Uuid
  assigned_at                                  DateTime                   @default(now()) @db.Timestamptz(6)
  responded_by                                 String?                    @db.Uuid
  responded_at                                 DateTime?                  @db.Timestamptz(6)
  response_reason                              String?                    @db.VarChar(500)
  ended_at                                     DateTime?                  @db.Timestamptz(6)
  end_reason                                   String?                    @db.VarChar(500)
  created_at                                   DateTime                   @default(now()) @db.Timestamptz(6)
  users_assignments_assigned_byTousers         users?                     @relation("assignments_assigned_byTousers", fields: [assigned_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  crews                                        crews?                     @relation(fields: [crew_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_assignments_responded_byTousers        users?                     @relation("assignments_responded_byTousers", fields: [responded_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_assignments_responsible_user_idTousers users                      @relation("assignments_responsible_user_idTousers", fields: [responsible_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  work_orders                                  work_orders                @relation(fields: [work_order_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_assignments_worker_idTousers           users?                     @relation("assignments_worker_idTousers", fields: [worker_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  work_order_state_history                     work_order_state_history[]

  @@unique([work_order_id], map: "ux_assignments_current", where: raw("((status)::text = 'ACTIVE'::text)"))
  @@index([crew_id, status], map: "ix_assignments_crew_status")
  @@index([responsible_user_id, status], map: "ix_assignments_responsible")
  @@index([worker_id, status], map: "ix_assignments_worker_status")
}

