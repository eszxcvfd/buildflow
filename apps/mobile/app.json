{
  "expo": {
    "name": "BuildFlow Mobile",
    "slug": "buildflow-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "buildflow",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "android": {
      "package": "com.buildflow.mobile",
      "edgeToEdgeEnabled": true,
      "minSdkVersion": 29,
      "permissions": []
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      }
    }
  }
}
