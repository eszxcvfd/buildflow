{
  "expo": {
    "name": "BuildFlow Mobile",
    "slug": "buildflow-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "buildflow",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.buildflow.mobile",
      "permissions": []
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 29
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      }
    }
  }
}
