# Copy to `infra/.env` (or use --env-file) and adjust for local development.
# Never commit a real `.env` file.

# PostgreSQL 18
POSTGRES_USER=buildflow
POSTGRES_PASSWORD=buildflow
POSTGRES_DB=buildflow
POSTGRES_PORT=5432
POSTGRES_VOLUME_NAME=buildflow_pgdata_v18

# MinIO (S3-compatible object storage)
MINIO_ROOT_USER=buildflow
MINIO_ROOT_PASSWORD=buildflow
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
