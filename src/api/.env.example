PORT=3000
# Host-side defaults for the Prisma CLI, e2e tests and local dev against the
# Docker Compose data services (see infra/docker/.env.example). The API
# container receives DATABASE_URL/REDIS_URL from compose instead.
DATABASE_URL=postgres://buildflow:buildflow@127.0.0.1:5432/buildflow
REDIS_URL=redis://127.0.0.1:6379
