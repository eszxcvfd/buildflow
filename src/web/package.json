{
  "name": "buildflow-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "test": "jest --passWithNoTests",
    "generate:api-types": "openapi-typescript ../api/openapi.json -o src/lib/api/generated.ts && node scripts/ensure-header.js",
    "openapi:generate": "openapi-typescript ../api/openapi.json -o src/lib/api/generated.ts && node scripts/ensure-header.js"
  },
  "dependencies": {
    "next": "14.2.5",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "20.11.30",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "eslint": "8.57.0",
    "eslint-config-next": "14.2.5",
    "openapi-typescript": "7.13.0",
    "typescript": "5.4.5"
  }
}
